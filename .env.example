DATA_DIR=/data
DATABASE_URL=sqlite:////data/modelgenerator.db
# Default: GPU-free, valid-GLB mock pipeline.
BACKEND_MODE=mock
API_BASE_URL=http://api:8000
BACKGROUND_COLOR=#FF00FF
BACKGROUND_TOLERANCE=48
# Real inference: set BACKEND_MODE=sf3d, run `hf auth login` on the host,
# execute scripts/download-model.ps1, then use docker-compose.sf3d.yml.
# Never put HF_TOKEN in this file or docker-compose.yml.
